<?xml version="1.0" encoding="utf-8"?>
<robot name="claw4">

  <!-- base -->
  <link name="P_base_Link">
    <inertial>
      <origin xyz="-1.0408E-17 -5.5511E-17 -0.20188" rpy="0 0 0"/>
      <mass value="6.4599"/>
      <inertia ixx="0.083236" ixy="-2.7657E-18" ixz="-2.4414E-19"
               iyy="0.055686" iyz="-4.8825E-18" izz="0.037663"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/P_base_Link.STL"/>
      </geometry>
    </visual>

    <!-- 简单方块碰撞体，包住底座 -->
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.40"/>
      </geometry>
    </collision>
  </link>

  <!-- first link -->
  <link name="P_1_Link">
    <inertial>
      <origin xyz="-0.062497 -0.0005981 0" rpy="0 0 0"/>
      <mass value="2.2998"/>
      <inertia ixx="0.0039767" ixy="-5.6996E-05" ixz="-1.5382E-19"
               iyy="0.0099317" iyz="4.7474E-20" izz="0.0099323"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/P_1_Link.STL"/>
      </geometry>
    </visual>

    <!-- 细长方块，沿本体 X 方向 -->
    <collision>
      <origin xyz="-0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="P_base_to_1_Link" type="revolute">
    <origin xyz="0 0 -0.37" rpy="1.5708 -1.5708 0"/>
    <parent link="P_base_Link"/>
    <child  link="P_1_Link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="100"/>
  </joint>

  <!-- second big arm -->
  <link name="P_2_Link">
    <inertial>
      <origin xyz="0.15684 0.02614 1.5096E-14" rpy="0 0 0"/>
      <mass value="6.2744"/>
      <inertia ixx="0.041558" ixy="-0.012336" ixz="-5.9208E-15"
               iyy="0.11352" iyz="-1.5073E-15" izz="0.090122"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/P_2_Link.STL"/>
      </geometry>
    </visual>

    <!-- 大臂：沿 X 方向的方块 -->
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="P_1_to_2_Link" type="revolute">
    <origin xyz="-0.12499 -0.0011962 0" rpy="1.5708 0.17993 -3.132"/>
    <parent link="P_1_Link"/>
    <child  link="P_2_Link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="100"/>
  </joint>

  <!-- left claw -->
  <link name="P_left_Link">
    <inertial>
      <origin xyz="0.047447 -0.069817 -4.9613E-14" rpy="0 0 0"/>
      <mass value="2.8208"/>
      <inertia ixx="0.019271" ixy="0.0010629" ixz="7.7385E-16"
               iyy="0.0069383" iyz="-3.6749E-16" izz="0.021508"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/P_left_Link.STL"/>
      </geometry>
    </visual>

    <!-- 左夹爪：小一点的方块 -->
    <collision>
      <origin xyz="0.05 -0.07 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="P_2_to_left_Link" type="revolute">
    <origin xyz="0.30414 0 0" rpy="-3.1416 0 -1.4056"/>
    <parent link="P_2_Link"/>
    <child  link="P_left_Link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="100"/>
  </joint>

  <!-- right claw -->
  <link name="P_right_Link">
    <inertial>
      <origin xyz="-0.059557 0.059821 -2.4026E-14" rpy="0 0 0"/>
      <mass value="2.8208"/>
      <inertia ixx="0.018461" ixy="0.0032347" ixz="-1.0671E-15"
               iyy="0.0077484" iyz="1.1488E-15" izz="0.021508"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/P_right_Link.STL"/>
      </geometry>
    </visual>

    <!-- 右夹爪：对称的小方块 -->
    <collision>
      <origin xyz="-0.06 0.06 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="P_2_to_right_Link" type="revolute">
    <origin xyz="0.2877 0.098639 0" rpy="0 0 -1.4056"/>
    <parent link="P_2_Link"/>
    <child  link="P_right_Link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="100"/>
  </joint>

</robot>
